%
o9070 (BOLT HOLE CIRCLE MACRO)
(CALL WITH CANNED CYCLE ACTIVE)
(I = BOLT HOLE RADIUS)
(J = START ANGLE DEG - DEFAULT 0)
(A = NUMBER OF HOLES)
(X Y = CENTER - DEFAULT CURRENT TOOL POS)
#10 = #4003 (G90 OR G91 MODE)
G90
(INITIAL SETUP)
IF[#4009 EQ 80] GOTO9907 (CYCLE ACTIVE?)
IF[#4 LE 0] GOTO9901 (RADIUS)
IF[#1 EQ #0] GOTO9906 (A GIVEN?)
IF[#1 NE FUP[#1]] GOTO9902 (# OF HOLES)
IF[#1 LE 0] GOTO9903
IF[#5 NE #0] GOTO1 (J GIVEN?)
#5 = 0 (DEFAULT START ANGLE)
N1 IF[#24 NE #0] GOTO2 (X GIVEN?)
#24 = #5001 (DEFAULT CENTER X = CURRENT X)
N2 IF[#25 NE #0] GOTO3 (Y GIVEN?)
#25 = #5002 (DEFAULT CENTER Y = CURRENT Y)
N3 #19 = 1 (FIRST HOLE)
(DRILLING LOOP)
WHILE[#19 LE #1] DO1
#30 = [#19-1]*360/#1+#5 (CURRENT HOLE ANGLE)
X[COS[#30]*#4+#24] Y[SIN[#30]*#4+#25]
#19 = #19+1 (INCREASE HOLE COUNTER)
END1
(X#24 Y#25 K0) (RETURN TO BOLT CIRCLE CENTER - NO DRILL)
(END OF MACRO)
GOTO9999
(ERROR HANDLING)
N9901 #3000=101 (RADIUS I MUST BE GT 0)
N9902 #3000=102 (HOLE COUNT A MUST BE INTEGER)
N9903 #3000=103 (ONLY POSITIVE NUM OF HOLES A)
N9906 #3000=106 (NUM OF HOLES A NOT GIVEN)
N9907 #3000=107 (NO CANNED CYCLE ACTIVE)
N9999 G#10
M99
%