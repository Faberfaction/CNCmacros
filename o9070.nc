%
o9070 (BOLT HOLE CIRCLE MACRO)
(CALL WITH CANNED CYCLE ACTIVE)
(W = BOLT CIRCLE DIA)
(H = NUMBER OF HOLES)
(X Y = CENTER - DEFAULT CURRENT TOOL POS)
(A = START ANGLE DEG - DEFAULT 0)
(S = START HOLE - DEFAULT 1)
#10 = #4003 (G90 OR G91 MODE)
G90
(INITIAL SETUP)
IF[#4009 EQ 80] GOTO9907 (CYCLE ACTIVE?)
IF[#23 LE 0] GOTO9901 (BCD)
IF[#11 EQ #0] GOTO9906 (H GIVEN?)
IF[#11 NE FUP[#11]] GOTO9902 (# OF HOLES)
IF[#11 LE 0] GOTO9903
IF[#19 NE #0] GOTO1 (S GIVEN?)
#19 = 1 (DEFAULT STARTING HOLE)
N1 IF[#19 NE FUP[#19]] GOTO9902
IF[#19 LT 1] GOTO9904
IF[#19 GT #11] GOTO9905
IF[#24 NE #0] GOTO2 (X GIVEN?)
#24 = #5001 (DEFAULT CENTER X = CURRENT X)
N2 IF[#25 NE #0] GOTO3 (Y GIVEN?)
#25 = #5002 (DEFAULT CENTER Y = CURRENT Y)
N3 #23 = #23/2 (BCD TO RADIUS)
(DRILLING LOOP)
WHILE[#19 LE #11] DO1
#30 = [#19-1]*360/#11+#1 (CURRENT HOLE ANGLE)
X[COS[#30]*#23+#24] Y[SIN[#30]*#23+#25]
#19 = #19+1 (INCREASE HOLE COUNTER)
END1
(X#24 Y#25 K0) (RETURN TO BCD CENTER - NO DRILL)
(END OF MACRO)
GOTO9999
(ERROR HANDLING)
N9901 #3000=101 (DIA MUST BE GT 0)
N9902 #3000=102 (HOLE DATA NE INTEGER)
N9903 #3000=103 (ONLY POSITIVE NUM OF HOLES)
N9904 #3000=104 (START HOLE NE INT)
N9905 #3000=105 (START HOLE OUT OF RANGE)
N9906 #3000=106 (NUM OF HOLES H NOT GIVEN)
N9907 #3000=107 (NO CANNED CYCLE ACTIVE)
N9999 G#10
M99
%